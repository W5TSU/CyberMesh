PORT=5090

# LAN IP or hostname of your Meshtastic node's WiFi TCP API. Only used when
# connecting over TCP (see MESHTASTIC_TRANSPORT below) — a static DHCP
# reservation is recommended since this is only read at process start, not
# re-resolved while running.
MESHTASTIC_HOST=192.168.1.100

# USB serial path to the same node, if you have one plugged in. Used as the
# primary transport when set (see MESHTASTIC_TRANSPORT), and by the watchdog
# to reboot the node when the TCP API wedges after a WiFi reconnect
# (meshtastic/firmware#10494) — TCP itself can't recover from that, serial
# can. Leave blank/unset if your node isn't on USB.
MESHTASTIC_SERIAL_PORT=/dev/ttyACM0

# "auto" = try USB serial first, fall back to WiFi TCP. "serial" or "tcp" to
# force one transport. Some boards' TCP API server is flaky under load —
# serial (if available) is generally the more reliable choice.
MESHTASTIC_TRANSPORT=auto

# Optional: origin for the node list's distance column/filter, and the
# fallback used when the node's own GPS has no fix (e.g. it's indoors).
# Leave unset to disable distance filtering until the node reports a real
# position.
# HOME_LAT=35.0
# HOME_LON=-97.0

# Optional: override where the SQLite message/node-history database lives.
# Defaults to messages.db next to app.py.
# MESSAGE_DB=/path/to/messages.db

# Optional single-node BBS (message boards + node-to-node mail over the mesh).
# Off by default.
# BBS_ENABLED=1

# Optional Range tab: active coverage probing against one chosen node.
# RANGE_PROBE_NODE is the node id (!hex) to probe; RANGE_HOME_LAT/LON should
# be your antenna's real surveyed position (falls back to HOME_LAT/LON when
# unset) since every distance on that tab is measured from here.
# RANGE_PROBE_NODE=!12345678
# RANGE_HOME_LAT=35.0
# RANGE_HOME_LON=-97.0
# RANGE_PROBE_CHANNEL=2
# RANGE_PROBE_SECS=300
# RANGE_PROBE_MOTION_WINDOW=900
# RANGE_PROBE_LINGER=1200
